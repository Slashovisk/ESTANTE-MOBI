<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 ou mais novo: backup na nuvem e transferência para um celular novo levam a estante junto. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="books/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="books/" />
    </device-transfer>
</data-extraction-rules>
